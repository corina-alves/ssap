# Proxy reverso da Sala de Situação (perfil "proxy" do compose.yaml).
# O nginx troca ${SERVIDOR_NOME} pelo valor do .env.docker ao iniciar.
# Certificado: deploy/certs/fullchain.pem e deploy/certs/privkey.pem.
# Serve também de modelo para o nginx da própria instituição (troque
# "app:3000" por "127.0.0.1:3000").

server_tokens off;

# Arquivos do Next com o conteúdo no nome (/_next/static/: JS, CSS, fontes): nunca
# mudam. O nginx guarda uma cópia (não chegam ao Node a cada visita) e repassa o
# "Cache-Control: public, max-age=31536000, immutable" que o Next manda.
# NÃO acrescente "Cache-Control: no-store" no server inteiro: o navegador baixaria
# tudo de novo a cada página (~290 KB e ~19 requisições a mais na página inicial).
proxy_cache_path /var/cache/nginx/ssap levels=1:2 keys_zone=ssap_estaticos:10m max_size=300m inactive=30d use_temp_path=off;

# Limite de requisições por IP (429 acima disto). Generoso para quem navega,
# inclusive vários usuários atrás do mesmo IP de uma rede; segura robôs e abuso.
# Só vale com este nginx de frente para a internet: atrás de outro proxy,
# $binary_remote_addr seria o IP do proxy e o limite valeria para todo mundo junto.
limit_req_zone $binary_remote_addr zone=ssap_geral:10m rate=30r/s;
# Envio de formulários e ações (POST): mais apertado. GET não entra nesta zona (chave vazia).
map $request_method $ssap_chave_post {
    default "";
    POST    $binary_remote_addr;
}
limit_req_zone $ssap_chave_post zone=ssap_post:10m rate=5r/s;
limit_req_status 429;

# Acesso em JSON, no mesmo formato dos logs da aplicação (src/lib/log.ts):
# o "req" é o X-Request-Id repassado ao app, que aparece também nos logs dele.
# Sem a query string ($uri, não $request_uri: o link de senha leva um código)
# e sem o IP do visitante (dado pessoal). "s" e "app_s" em segundos.
log_format ssap_json escape=json
    '{"ts":"$time_iso8601","nivel":"info","evento":"http","req":"$request_id",'
    '"metodo":"$request_method","caminho":"$uri","status":$status,'
    '"s":$request_time,"app_s":"$upstream_response_time","bytes":$body_bytes_sent}';

# HTTP: só redireciona para HTTPS
server {
    listen 80;
    server_name ${SERVIDOR_NOME};

    location = /saude-proxy {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVIDOR_NOME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # upload de PDF de boletim: até 30 MB (o mesmo limite da aplicação) + folga
    client_max_body_size 32m;

    access_log /dev/stdout ssap_json;

    location ^~ /_next/static/ {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_cache       ssap_estaticos;
        proxy_cache_valid 200 30d;
        proxy_cache_lock  on; # vários pedidos do mesmo arquivo ao mesmo tempo: um só vai ao app
        access_log off;
        # add_header aqui dentro descarta os do server: o HSTS vai repetido
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location / {
        limit_req zone=ssap_geral burst=120 nodelay;
        limit_req zone=ssap_post burst=20 nodelay;
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        # $http_host mantém a porta, se houver: a aplicação confere a origem dos formulários por ele
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # o último endereço da lista é o do cliente real (TRUST_PROXY=true usa esse)
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # mesmo identificador no log do nginx e nos logs da aplicação (o app o devolve na resposta)
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "";
        # páginas que consultam várias APIs externas podem demorar na primeira vez
        proxy_connect_timeout 10s;
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
    }
}
