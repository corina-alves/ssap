# Proxy reverso da Sala de Situação (perfil "proxy" do compose.yaml).
# O nginx troca ${SERVIDOR_NOME} pelo valor do .env.docker ao iniciar.
# Certificado: deploy/certs/fullchain.pem e deploy/certs/privkey.pem.
# Serve também de modelo para o nginx da própria instituição (troque
# "app:3000" por "127.0.0.1:3000").

server_tokens off;

# HTTP: só redireciona para HTTPS
server {
    listen 80;
    server_name ${SERVIDOR_NOME};

    location = /saude-proxy {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVIDOR_NOME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # upload de PDF de boletim: até 30 MB (o mesmo limite da aplicação) + folga
    client_max_body_size 32m;

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        # $http_host mantém a porta, se houver: a aplicação confere a origem dos formulários por ele
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # o último endereço da lista é o do cliente real (TRUST_PROXY=true usa esse)
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "";
        # páginas que consultam várias APIs externas podem demorar na primeira vez
        proxy_connect_timeout 10s;
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
    }
}
