# Configuração da aplicação no Docker. Copie para .env.docker e ajuste.
# O .env.docker nunca vai para o repositório.
#
# As SENHAS DO BANCO não ficam aqui: ficam em arquivos na pasta secrets/
# (secrets/postgres_password.txt e secrets/app_db_password.txt — veja DOCKER.md).

# Endereço público da aplicação (usado nos links de definição de senha).
APP_URL=https://salasituacao.exemplo.sp.gov.br

# Nome do servidor no certificado HTTPS (só para o perfil "proxy").
SERVIDOR_NOME=salasituacao.exemplo.sp.gov.br

# true atrás do proxy reverso que define X-Forwarded-For (recomendado em produção).
# Sem proxy reverso na frente, use false.
TRUST_PROXY=true

# Login do SAISP (radar da SP Águas), para a imagem de acumulado do Boletim Diário. Opcional.
SAISP_USUARIO=
SAISP_SENHA=

# Proxy da instituição para as APIs externas (descomente se houver).
# NO_PROXY precisa incluir "db" para a conexão com o banco não passar pelo proxy.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.exemplo:8080
# HTTP_PROXY=http://proxy.exemplo:8080
# NO_PROXY=db,localhost,127.0.0.1

# Proxy que inspeciona HTTPS: aponte para o certificado raiz da instituição
# (monte o arquivo no serviço "app" — veja DOCKER.md).
# NODE_EXTRA_CA_CERTS=/certs/ca-instituicao.pem
