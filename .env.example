# Copie para .env.local e preencha. O .env.local nunca vai para o repositório.

# Conexão com o PostgreSQL (obrigatória — a aplicação não inicia sem ela).
# Use um usuário próprio da aplicação, não o superusuário postgres.
DATABASE_URL=postgres://ssap_app:TROQUE_A_SENHA@localhost:5432/ssap

# Endereço público da aplicação, usado nos links de definição de senha.
# Em branco: usa o endereço da própria requisição.
APP_URL=

# Pasta dos arquivos enviados (PDFs de boletins, documentos). Fora da pasta
# pública e com backup. Em branco: ./storage dentro do projeto.
STORAGE_DIR=

# Cache das integrações externas (descartável, sem backup). Em branco: ./.cache/integracoes
CACHE_DIR=

# Atrás de proxy corporativo (fora do Docker): NODE_USE_ENV_PROXY=1 e HTTPS_PROXY=http://proxy:porta
# definidos no ambiente ANTES de iniciar o Node (não funcionam neste arquivo).
# No Docker, use SSSP_PROXY no .env.docker (veja DOCKER.md).

# true somente atrás de um proxy reverso confiável (IIS, nginx) que define
# X-Forwarded-For. Em false, o IP do cliente vem da conexão direta.
TRUST_PROXY=false

# Login do SAISP (radar da SP Águas), para a imagem de acumulado do Boletim Diário. Opcional.
SAISP_USUARIO=
SAISP_SENHA=

# Planilha horária da EMAE (Dados_SP_AGUAS.xlsx, SharePoint da EMAE, site GO-Operacao)
# para o Sumário Executivo Automático Alto Tietê/Pinheiros, lida pelo Microsoft Graph
# com um aplicativo registrado no Entra ID da EMAE (só leitura, Sites.Selected no site).
# Sem estes dados, o quadro da EMAE fica "aguardando integração" e o resto da página
# funciona. EMAE_PLANILHA_URL = endereço do arquivo no SharePoint (o servidor localiza o
# arquivo sozinho); EMAE_DRIVE_ID + EMAE_ITEM_ID, se informados, têm prioridade. EMAE_ABA é opcional.
EMAE_TENANT_ID=
EMAE_CLIENT_ID=
EMAE_CLIENT_SECRET=
EMAE_DRIVE_ID=
EMAE_ITEM_ID=
EMAE_PLANILHA_URL=
EMAE_ABA=
# Coleta do sumário a cada 10 min (padrão: ligada). "off" desliga.
SUMARIO_TP_COLETA=

# Logs (JSON no stdout/stderr — veja DOCKER.md, Logs). Todos opcionais.
# Nível mínimo: debug, info (padrão), warn ou error. debug registra também cada
# chamada bem-sucedida às APIs externas: use só para investigar um problema.
LOG_NIVEL=info
# Consulta ao banco mais lenta que isto (ms) é registrada como "banco_lento".
LOG_DB_LENTO_MS=1000
# Chamada a uma API externa mais lenta que isto (ms) é registrada como "api_lenta".
LOG_API_LENTA_MS=8000
